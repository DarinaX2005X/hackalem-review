{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methodVersion",
    "repoId",
    "caseId",
    "model",
    "snapshot",
    "overallSummary",
    "global",
    "case",
    "judgeScore",
    "caseRequirements",
    "testData",
    "runtime",
    "liveDemo",
    "fiveHourContext",
    "strengths",
    "gaps",
    "futureAdvice",
    "uncertainties",
    "reviewPolicyVersion",
    "assessmentStatus",
    "findings",
    "gapFindingIds"
  ],
  "properties": {
    "methodVersion": {
      "type": "integer",
      "const": 4
    },
    "repoId": {
      "type": "string"
    },
    "caseId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "model": {
      "type": "string",
      "enum": [
        "GPT-6 Luna",
        "GPT-5.6 Luna"
      ]
    },
    "snapshot": {
      "type": "string"
    },
    "overallSummary": {
      "type": "string"
    },
    "global": {
      "$ref": "#/$defs/scale"
    },
    "case": {
      "type": [
        "object",
        "null"
      ],
      "anyOf": [
        {
          "$ref": "#/$defs/scale"
        },
        {
          "type": "null"
        }
      ]
    },
    "judgeScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "caseRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "status",
          "explanation",
          "evidence"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "partial",
              "missing",
              "unverified"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "testData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided",
        "used",
        "checks",
        "limitations"
      ],
      "properties": {
        "provided": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "method",
              "result",
              "conclusion"
            ],
            "properties": {
              "input": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "conclusion": {
                "type": "string"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "build",
        "start",
        "scenario",
        "environment",
        "summary",
        "checks",
        "limitations"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "working",
            "partial",
            "failed",
            "blocked"
          ]
        },
        "build": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "result",
              "id",
              "stage",
              "status",
              "cause",
              "expected"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "build",
                  "start",
                  "scenario"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "blocked",
                  "not_run"
                ]
              },
              "cause": {
                "type": "string",
                "enum": [
                  "none",
                  "project",
                  "review_environment",
                  "external_service",
                  "unknown"
                ]
              },
              "expected": {
                "type": "string"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "liveDemo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unreachable",
            "claimed",
            "none",
            "unverified"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "fiveHourContext": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "futureAdvice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principle",
          "why",
          "how",
          "findingIds",
          "successCheck",
          "timeboxMinutes"
        ],
        "properties": {
          "principle": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "how": {
            "type": "string"
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "successCheck": {
            "type": "string"
          },
          "timeboxMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewPolicyVersion": {
      "type": "integer",
      "const": 2
    },
    "assessmentStatus": {
      "type": "string",
      "enum": [
        "ready",
        "incomplete"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "verification",
          "responsibility",
          "claim",
          "expected",
          "actual",
          "evidence",
          "checkIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "defect",
              "strength",
              "limitation"
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "observed",
              "source",
              "unverified"
            ]
          },
          "responsibility": {
            "type": "string",
            "enum": [
              "project",
              "review_environment",
              "external_service",
              "unknown"
            ]
          },
          "claim": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gapFindingIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "total"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "score",
              "max",
              "awarded",
              "deductions",
              "evidence",
              "deductionItems",
              "awardedDetails",
              "scoreReasoning"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "awarded": {
                "type": "string"
              },
              "deductions": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deductionItems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "points",
                    "findingId",
                    "reason"
                  ],
                  "properties": {
                    "points": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "findingId": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              },
              "awardedDetails": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "aspect",
                    "implementation",
                    "value",
                    "verification",
                    "evidence"
                  ],
                  "properties": {
                    "aspect": {
                      "type": "string",
                      "minLength": 1
                    },
                    "implementation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verification": {
                      "type": "string",
                      "enum": [
                        "observed",
                        "source"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "scoreReasoning": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "total": {
          "type": "number"
        }
      }
    }
  }
}
